# Set these variables in your terminal or MCP client.
# The app does not read this file.
# Store the API key in a secret manager.
GEMINI_FILE_SEARCH_API_KEY=
# Put only approved files in this directory.
GEMINI_UPLOAD_ROOT=/absolute/path/to/approved-documents
# Use --model to select a different model.
GEMINI_FILE_SEARCH_MODEL=gemini-3.8-flash
